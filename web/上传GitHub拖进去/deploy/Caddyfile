# 自动 HTTPS（证书由 Caddy 向 Let's Encrypt 申请并自动续期）
# 启动前把 your.domain 换成你的域名，并确保域名 A 记录已指向这台服务器
#   DOMAIN=your.domain docker compose -f deploy/docker-compose.yml --profile https up -d
#
# ⚠️ 国内服务器前提：域名必须已 ICP 备案。未备案域名走 80/443 会被云厂商拦截，
#   那种情况请直接用 http://服务器IP/ 访问（不走这个 profile）。

{$DOMAIN} {
	encode gzip

	handle_path /web/* {
		rewrite * /web{uri}
		reverse_proxy app:8000
	}

	reverse_proxy app:8000
}
