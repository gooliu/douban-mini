/**app.wxss 全局样式（豆瓣绿主题）**/
page {
  background: #f5f6f4;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 演示数据提示横幅 */
.mock-banner {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #fff8e6;
  color: #b27b00;
  font-size: 24rpx;
  border-radius: 12rpx;
  margin: 16rpx 24rpx;
}
.mock-banner .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f5a623;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin: 24rpx;
}
.user-card .avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #eee;
  flex-shrink: 0;
}
.user-card .info {
  flex: 1;
  min-width: 0;
}
.user-card .name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.user-card .meta {
  font-size: 24rpx;
  color: #999;
}
.user-card .signature {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
}
