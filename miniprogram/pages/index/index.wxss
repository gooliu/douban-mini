.container {
  padding-bottom: 60rpx;
}

.hero {
  text-align: center;
  padding: 100rpx 0 60rpx;
}
.hero .logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 28rpx;
  border-radius: 32rpx;
  background: #42bd56;
  color: #fff;
  font-size: 80rpx;
  font-weight: 700;
}
.hero .title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero .subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #888;
}

.search-box {
  margin: 0 48rpx;
}
.input {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid #e5e5e5;
}
.ph {
  color: #bbb;
}
.btn {
  margin-top: 28rpx;
  background: #42bd56;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  letter-spacing: 8rpx;
}
.btn-loading {
  background: #a5d9b0;
}
.example {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #42bd56;
  text-decoration: underline;
}

.error {
  margin: 32rpx 48rpx 0;
  background: #fdecea;
  color: #d93025;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  word-break: break-all;
}

.tips {
  margin: 64rpx 48rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
}
.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 14rpx;
}
.tips-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

/* 设置面板里的输入 / 按钮 */
.tips .input {
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
}
.tips .btn {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  padding: 10rpx 0;
}
.tips-title:active { opacity: .6; }
